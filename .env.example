# Copiar a .env y cambiar AMBAS contraseñas antes del primer inicio.
# Usar caracteres alfanuméricos largos para evitar problemas de sintaxis en Bash.
MYSQL_ROOT_PASSWORD=CAMBIAR_ROOT_PASSWORD
MYSQL_DATABASE=navidrome_lab
MYSQL_USER=navidrome_lab
MYSQL_PASSWORD=CAMBIAR_USER_PASSWORD

# Puerto publicado por Navidrome en la máquina Linux.
APP_PORT=4533
ND_SCANINTERVAL=1h
ND_LOGLEVEL=info
ND_SESSIONTIMEOUT=48h
